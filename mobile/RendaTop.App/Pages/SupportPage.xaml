<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.SupportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Atendimento"
    BackgroundColor="#F8FAFC">
    <Grid>
        <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
            <CollectionView
                x:Name="TicketsCollection"
                SelectionMode="Single"
                SelectionChanged="OnSelectionChanged"
                ItemSizingStrategy="MeasureFirstItem"
                Margin="0,0,0,20">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="18,16,18,16" Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Atendimento" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                                <Label Text="Abra chamados e acompanhe o historico recente da sua conta." TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Button
                                x:Name="CreateButton"
                                Grid.Column="1"
                                Text="Novo chamado"
                                BackgroundColor="#111827"
                                TextColor="White"
                                Padding="14,10"
                                VerticalOptions="Center"
                                Clicked="OnCreateClicked" />
                        </Grid>

                        <Border x:Name="OfflineBorder" BackgroundColor="#FFF7ED" Stroke="#FDBA74" Padding="14" IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label Text="Modo offline ativo. Voce pode consultar os chamados em leitura, mas nao pode abrir novos ou responder agora." TextColor="#9A3412" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Abertos" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="OpenCountLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Arquivados" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="ArchivedCountLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" BackgroundColor="White" Stroke="#E2E8F0" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Pendentes para o time" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="WaitingAdminCountLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Aguardando voce" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="WaitingUserCountLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Filtros" FontAttributes="Bold" TextColor="#111827" />

                                <Picker
                                    x:Name="ScopePicker"
                                    Title="Visao"
                                    ItemDisplayBinding="{Binding Label}"
                                    SelectedIndexChanged="OnFiltersChanged" />

                                <Picker
                                    x:Name="StatusPicker"
                                    Title="Status"
                                    ItemDisplayBinding="{Binding Label}"
                                    SelectedIndexChanged="OnFiltersChanged" />

                                <Entry
                                    x:Name="SearchEntry"
                                    Placeholder="Buscar por titulo ou conteudo"
                                    ReturnType="Search"
                                    Completed="OnSearchCompleted" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button
                                        Text="Buscar"
                                        BackgroundColor="#111827"
                                        TextColor="White"
                                        Clicked="OnSearchClicked" />
                                    <Button
                                        Grid.Column="1"
                                        Text="Limpar"
                                        BackgroundColor="White"
                                        BorderColor="#CBD5E1"
                                        BorderWidth="1"
                                        TextColor="#111827"
                                        Clicked="OnClearSearchClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />
                        <Label x:Name="EmptyLabel" Text="Nenhum chamado encontrado para os filtros atuais." TextColor="#64748B" IsVisible="False" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14" Margin="18,0,18,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label
                                        Text="{Binding Subject}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#111827"
                                        LineBreakMode="WordWrap" />
                                    <Border Grid.Column="1" BackgroundColor="{Binding StatusBackground}" Stroke="{Binding StatusStroke}" Padding="8,4" VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="999" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold" TextColor="{Binding StatusText}" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Preview}" TextColor="#475569" LineBreakMode="WordWrap" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Ultima mensagem" FontSize="12" TextColor="#64748B" />
                                        <Label Text="{Binding LastMessageAtLabel}" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Mensagens" FontSize="12" TextColor="#64748B" />
                                        <Label Text="{Binding MessageCountLabel}" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border BackgroundColor="{Binding PendingBackground}" Stroke="{Binding PendingStroke}" Padding="10,5" VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="999" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding PendingLabel}" FontSize="11" FontAttributes="Bold" TextColor="{Binding PendingText}" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding CreatedAtLabel}"
                                        FontSize="12"
                                        TextColor="#64748B"
                                        VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" Margin="18,0,18,20" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                            <Button Text="Tentar novamente" BackgroundColor="#991B1B" TextColor="White" Clicked="OnRetryClicked" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
