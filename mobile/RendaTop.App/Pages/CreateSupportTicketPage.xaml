<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.CreateSupportTicketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Novo chamado"
    BackgroundColor="#F8FAFC">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,28" Spacing="16">
            <Button
                Text="Retornar"
                ImageSource="icon_back_dark.svg"
                ContentLayout="Left,10"
                BackgroundColor="White"
                BorderColor="#CBD5E1"
                BorderWidth="1"
                TextColor="#111827"
                HorizontalOptions="Start"
                Padding="14,10"
                Clicked="OnBackClicked" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Abrir novo chamado" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                <Label Text="Descreva o contexto com clareza para acelerar o atendimento." TextColor="#64748B" />
            </VerticalStackLayout>

            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Assunto" FontAttributes="Bold" TextColor="#111827" />
                        <Entry x:Name="SubjectEntry" Placeholder="Resumo curto do problema" MaxLength="180" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mensagem" FontAttributes="Bold" TextColor="#111827" />
                        <Editor
                            x:Name="MessageEditor"
                            Placeholder="Explique o problema, o contexto e o que ja tentou fazer."
                            AutoSize="TextChanges"
                            MinimumHeightRequest="180"
                            BackgroundColor="#F8FAFC"
                            TextColor="#111827" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Anexos" FontAttributes="Bold" TextColor="#111827" />
                        <Button
                            Text="Selecionar arquivos"
                            BackgroundColor="White"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            TextColor="#111827"
                            Clicked="OnPickAttachmentsClicked" />
                        <Label Text="Formatos aceitos: imagens, PDF e Office. Maximo de 1 MB por arquivo." FontSize="12" TextColor="#64748B" />

                        <CollectionView
                            x:Name="AttachmentsCollection"
                            SelectionMode="None"
                            IsVisible="False"
                            ItemsLayout="VerticalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12" Margin="0,0,0,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding FileName}" FontAttributes="Bold" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding SizeLabel}" FontSize="12" TextColor="#64748B" />
                                            </VerticalStackLayout>
                                            <Button
                                                Grid.Column="1"
                                                Text="Remover"
                                                FontSize="12"
                                                Padding="10,6"
                                                BackgroundColor="White"
                                                BorderColor="#CBD5E1"
                                                BorderWidth="1"
                                                TextColor="#111827"
                                                Clicked="OnRemoveAttachmentClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                    </Border>

                    <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />

                    <Button
                        x:Name="SaveButton"
                        Text="Abrir chamado"
                        BackgroundColor="#111827"
                        TextColor="White"
                        Padding="14,12"
                        Clicked="OnSaveClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
