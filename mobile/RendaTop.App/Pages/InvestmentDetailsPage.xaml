<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.InvestmentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:RendaTop.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalhes do investimento"
    BackgroundColor="#F8FAFC">
    <Grid>
        <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
            <ScrollView>
                <VerticalStackLayout Padding="18,16,18,112" Spacing="16">
                    <!-- <Button
                        Text="Voltar"
                        ImageSource="icon_back_dark.svg"
                        ContentLayout="Left,10"
                        BackgroundColor="White"
                        BorderColor="#CBD5E1"
                        BorderWidth="1"
                        TextColor="#111827"
                        HorizontalOptions="Start"
                        Padding="14,10"
                        Clicked="OnBackClicked" /> -->

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="TitleLabel" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                        <Label x:Name="SubtitleLabel" TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Border x:Name="OfflineBorder" BackgroundColor="#FFF7ED" Stroke="#FDBA74" Padding="12" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="Modo offline ativo. Este investimento fica disponivel apenas para leitura." TextColor="#9A3412" />
                    </Border>

                    <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Dados do investimento" FontSize="18" FontAttributes="Bold" TextColor="#111827" />

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Banco" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="BankLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Tipo" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="TypeLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Spacing="3">
                                    <Label Text="Indexador" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="IndexLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                    <Label Text="Valor investido" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="InvestedValueLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="2" Spacing="3">
                                    <Label Text="Data de compra" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="BuyDateLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="3">
                                    <Label Text="Vencimento / resgate" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="DueDateLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label x:Name="TaxesLabel" FontSize="13" TextColor="#475569" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="Posicao atual" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                <Button Grid.Column="1" Text="i" WidthRequest="30" HeightRequest="30" CornerRadius="15" FontAttributes="Bold" BackgroundColor="#E2E8F0" TextColor="#111827" Clicked="OnCurrentValueTipClicked" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Valor bruto" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="CurrentGrossValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Valor liquido atual" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="CurrentNetValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Rendimento liquido atual" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="CurrentProfitLabel" FontSize="18" FontAttributes="Bold" TextColor="#16A34A" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Taxa efetiva estimada" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="CurrentRateLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label x:Name="ProjectionTitleLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                            <Label x:Name="ProjectionSubtitleLabel" TextColor="#64748B" FontSize="13" />

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Valor bruto estimado" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="ProjectionGrossValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Valor liquido estimado" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="ProjectionNetValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Rendimento liquido estimado" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="ProjectionProfitLabel" FontSize="18" FontAttributes="Bold" TextColor="#16A34A" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Taxa efetiva estimada" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="ProjectionRateLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="Impostos" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <Button Text="IR" HeightRequest="30" Padding="10,0" BackgroundColor="#E2E8F0" TextColor="#111827" Clicked="OnIrTipClicked" />
                                    <Button Text="IOF" HeightRequest="30" Padding="10,0" BackgroundColor="#E2E8F0" TextColor="#111827" Clicked="OnIofTipClicked" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="IR atual" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="CurrentIrValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                        <Label x:Name="CurrentIrPercentLabel" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="IOF atual" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="CurrentIofValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                        <Label x:Name="CurrentIofPercentLabel" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="IR estimado no vencimento" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="ProjectionIrValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                        <Label x:Name="ProjectionIrPercentLabel" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="IOF estimado no vencimento" FontSize="12" TextColor="#64748B" />
                                        <Label x:Name="ProjectionIofValueLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                        <Label x:Name="ProjectionIofPercentLabel" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="InfoBorder" BackgroundColor="#EFF6FF" Stroke="#93C5FD" Padding="12" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="InfoLabel" TextColor="#1D4ED8" />
                    </Border>

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="Resgates" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                <Label x:Name="RedeemedTotalLabel" Grid.Column="1" TextColor="#64748B" VerticalTextAlignment="Center" />
                            </Grid>

                            <Label x:Name="RedemptionsEmptyLabel" Text="Nenhum resgate registrado." TextColor="#64748B" IsVisible="False" />

                            <CollectionView x:Name="RedemptionsCollection" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12" Margin="0,0,0,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="{Binding AmountLabel}" FontAttributes="Bold" TextColor="#111827" />
                                                </Grid>

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <Label Text="{Binding DateLabel}" TextColor="#64748B" />
                                                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                                        <Button
                                                            Text="Editar"
                                                            FontSize="12"
                                                            Padding="10,6"
                                                            BackgroundColor="White"
                                                            BorderColor="#CBD5E1"
                                                            BorderWidth="1"
                                                            TextColor="#111827"
                                                            IsEnabled="{Binding CanWrite}"
                                                            Clicked="OnEditRedemptionClicked" />
                                                        <Button
                                                            Text="Excluir"
                                                            FontSize="12"
                                                            Padding="10,6"
                                                            BackgroundColor="White"
                                                            BorderColor="#FCA5A5"
                                                            BorderWidth="1"
                                                            TextColor="#991B1B"
                                                            IsEnabled="{Binding CanWrite}"
                                                            Clicked="OnDeleteRedemptionClicked" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                            <Button Text="Tentar novamente" BackgroundColor="#991B1B" TextColor="White" Clicked="OnRetryClicked" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:FloatingActionMenu x:Name="PageFab" />
    </Grid>
</ContentPage>
