<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.StoreSubscriptionCheckoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pagamento na loja"
    BackgroundColor="#F8FAFC">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,24" Spacing="16">
            <Button
                Text="Retornar"
                ImageSource="icon_back_dark.svg"
                ContentLayout="Left,10"
                BackgroundColor="White"
                BorderColor="#CBD5E1"
                BorderWidth="1"
                TextColor="#111827"
                HorizontalOptions="Start"
                Padding="14,10"
                Clicked="OnBackClicked" />

            <VerticalStackLayout Spacing="4">
                <Label x:Name="HeadingLabel" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                <Label x:Name="DescriptionLabel" TextColor="#64748B" />
            </VerticalStackLayout>

            <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />

            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Resumo" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Plataforma" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="PlatformLabel" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Provedor" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="ProviderLabel" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Plano" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="PlanLabel" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Preco" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="PriceLabel" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="NoticeBorder" BackgroundColor="#EFF6FF" Stroke="#93C5FD" Padding="12" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="NoticeLabel" TextColor="#1D4ED8" />
            </Border>

            <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="ErrorLabel" TextColor="#991B1B" />
            </Border>

            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Fluxo de pagamento" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                    <Label x:Name="FlowDescriptionLabel" TextColor="#475569" />
                    <Button x:Name="PurchaseButton" BackgroundColor="#111827" TextColor="White" Clicked="OnPurchaseClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
