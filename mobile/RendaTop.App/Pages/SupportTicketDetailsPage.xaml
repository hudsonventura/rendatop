<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.SupportTicketDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalhes do chamado"
    BackgroundColor="#F8FAFC">
    <Grid>
        <CollectionView
            x:Name="MessagesCollection"
            SelectionMode="None"
            ItemSizingStrategy="MeasureFirstItem"
            Margin="0,0,0,20">
            <CollectionView.Header>
                <VerticalStackLayout Padding="18,16,18,16" Spacing="16">
                    <Button
                        Text="Retornar"
                        ImageSource="icon_back_dark.svg"
                        ContentLayout="Left,10"
                        BackgroundColor="White"
                        BorderColor="#CBD5E1"
                        BorderWidth="1"
                        TextColor="#111827"
                        HorizontalOptions="Start"
                        Padding="14,10"
                        Clicked="OnBackClicked" />

                    <Border x:Name="OfflineBorder" BackgroundColor="#FFF7ED" Stroke="#FDBA74" Padding="12" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="Modo offline ativo. Este chamado fica disponivel apenas para leitura." TextColor="#9A3412" />
                    </Border>

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label x:Name="SubjectLabel" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border x:Name="StatusBorder" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" Padding="10,5" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Label x:Name="StatusLabel" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                                </Border>
                                <Label x:Name="PendingLabel" Grid.Column="1" TextColor="#64748B" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Solicitante" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="RequesterLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Ultima atualizacao" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="UpdatedAtLabel" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label x:Name="TicketMetaLabel" FontSize="12" TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="ReplyBorder" BackgroundColor="White" Stroke="#E2E8F0" Padding="16" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Responder chamado" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                <Label Text="Este chamado esta aguardando sua resposta." TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Editor
                                x:Name="ReplyEditor"
                                Placeholder="Escreva sua resposta"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="140"
                                BackgroundColor="#F8FAFC"
                                TextColor="#111827" />

                            <VerticalStackLayout Spacing="8">
                                <Button
                                    Text="Selecionar arquivos"
                                    BackgroundColor="White"
                                    BorderColor="#CBD5E1"
                                    BorderWidth="1"
                                    TextColor="#111827"
                                    Clicked="OnPickAttachmentsClicked" />
                                <Label Text="Formatos aceitos: imagens, PDF e Office. Maximo de 1 MB por arquivo." FontSize="12" TextColor="#64748B" />

                                <CollectionView
                                    x:Name="ReplyAttachmentsCollection"
                                    SelectionMode="None"
                                    IsVisible="False"
                                    ItemsLayout="VerticalList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="12" Margin="0,0,0,8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding FileName}" FontAttributes="Bold" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding SizeLabel}" FontSize="12" TextColor="#64748B" />
                                                    </VerticalStackLayout>
                                                    <Button
                                                        Grid.Column="1"
                                                        Text="Remover"
                                                        FontSize="12"
                                                        Padding="10,6"
                                                        BackgroundColor="White"
                                                        BorderColor="#CBD5E1"
                                                        BorderWidth="1"
                                                        TextColor="#111827"
                                                        Clicked="OnRemoveAttachmentClicked" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <Border x:Name="ReplyErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label x:Name="ReplyErrorLabel" TextColor="#991B1B" />
                            </Border>

                            <Button
                                x:Name="ReplyButton"
                                Text="Enviar resposta"
                                BackgroundColor="#111827"
                                TextColor="White"
                                Padding="14,12"
                                Clicked="OnReplyClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />
                    <Label x:Name="EmptyLabel" Text="Nenhuma mensagem encontrada neste chamado." TextColor="#64748B" IsVisible="False" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14" Margin="18,0,18,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding SenderName}" FontAttributes="Bold" TextColor="#111827" />
                                    <Label Text="{Binding SenderTypeLabel}" FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding CreatedAtLabel}" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding BodyText}" TextColor="#475569" LineBreakMode="WordWrap" />

                            <CollectionView ItemsSource="{Binding Attachments}" SelectionMode="None" IsVisible="{Binding HasAttachments}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="10" Margin="0,0,0,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding FileName}" FontAttributes="Bold" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding MetaLabel}" FontSize="12" TextColor="#64748B" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" Margin="18,0,18,20" IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                        <Button Text="Tentar novamente" BackgroundColor="#991B1B" TextColor="White" Clicked="OnRetryClicked" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
