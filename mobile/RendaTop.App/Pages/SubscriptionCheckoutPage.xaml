<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.SubscriptionCheckoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pagamento"
    BackgroundColor="#F8FAFC">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,24" Spacing="16">
            <Button
                Text="Voltar"
                ImageSource="icon_back_dark.svg"
                ContentLayout="Left,10"
                BackgroundColor="White"
                BorderColor="#CBD5E1"
                BorderWidth="1"
                TextColor="#111827"
                HorizontalOptions="Start"
                Padding="14,10"
                Clicked="OnBackClicked" />

            <VerticalStackLayout Spacing="4">
                <Label x:Name="HeadingLabel" Text="Preparando pagamento" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                <Label Text="Pagamento processado com seguranca pelo Mercado Pago" TextColor="#64748B" />
            </VerticalStackLayout>

            <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />

            <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label x:Name="ErrorLabel" TextColor="#991B1B" />
            </Border>

            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Resumo" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Plano" FontSize="12" TextColor="#64748B" />
                            <Label x:Name="PlanLabel" Text="-" FontAttributes="Bold" TextColor="#111827" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                            <Label Text="Valor" FontSize="12" TextColor="#64748B" HorizontalTextAlignment="End" />
                            <Label x:Name="PriceLabel" Text="-" FontAttributes="Bold" TextColor="#111827" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#EFF6FF" Stroke="#93C5FD" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Pagamento no Mercado Pago" FontAttributes="Bold" TextColor="#1E3A8A" />
                    <Label
                        Text="As formas de pagamento disponiveis serao apresentadas no ambiente seguro do Mercado Pago."
                        TextColor="#1D4ED8" />
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="ContinueButton"
                Text="Continuar no Mercado Pago"
                BackgroundColor="#111827"
                TextColor="White"
                HeightRequest="48"
                IsEnabled="False"
                Clicked="OnContinueClicked" />

            <Border x:Name="CheckoutOpenedBorder" BackgroundColor="#F0FDF4" Stroke="#86EFAC" Padding="14" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Checkout aberto" FontAttributes="Bold" TextColor="#166534" />
                    <Label Text="Depois de concluir ou cancelar o pagamento, retorne ao RendaTop para atualizar o status da assinatura." TextColor="#166534" />
                    <Button
                        Text="Voltar para assinatura"
                        BackgroundColor="White"
                        BorderColor="#22C55E"
                        BorderWidth="1"
                        TextColor="#166534"
                        Clicked="OnPaymentCompletedClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
