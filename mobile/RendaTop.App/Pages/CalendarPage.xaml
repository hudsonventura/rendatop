<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Calendario"
    BackgroundColor="#F8FAFC">
    <Grid>
        <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
            <ScrollView>
                <VerticalStackLayout Padding="18,16,18,24" Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Calendario" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                        <Label Text="Visualize as datas de aplicacao e vencimento dos seus investimentos" TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Button Text="&lt;&lt;" BackgroundColor="White" BorderColor="#CBD5E1" BorderWidth="1" TextColor="#111827" Clicked="OnPreviousYearClicked" />
                                <Button Grid.Column="1" Text="&lt;" BackgroundColor="White" BorderColor="#CBD5E1" BorderWidth="1" TextColor="#111827" Clicked="OnPreviousMonthClicked" />
                                <Label x:Name="MonthLabel" Grid.Column="2" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#111827" />
                                <Button Grid.Column="3" Text="&gt;" BackgroundColor="White" BorderColor="#CBD5E1" BorderWidth="1" TextColor="#111827" Clicked="OnNextMonthClicked" />
                                <Button Grid.Column="4" Text="&gt;&gt;" BackgroundColor="White" BorderColor="#CBD5E1" BorderWidth="1" TextColor="#111827" Clicked="OnNextYearClicked" />
                            </Grid>

                            <Button Text="Hoje" BackgroundColor="#111827" TextColor="White" Clicked="OnTodayClicked" />

                            <HorizontalStackLayout Spacing="18">
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="#16A34A" StrokeThickness="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Aplicacao" TextColor="#475569" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="#2563EB" StrokeThickness="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Vencimento" TextColor="#475569" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                            <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />
                            <Label x:Name="EmptyLabel" Text="Nenhum investimento encontrado para montar o calendario." TextColor="#64748B" IsVisible="False" />

                            <Grid x:Name="WeekDaysGrid" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" />
                            <Grid x:Name="CalendarGrid" ColumnSpacing="6" RowSpacing="6" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                            <Button Text="Tentar novamente" BackgroundColor="#991B1B" TextColor="White" Clicked="OnRetryClicked" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
