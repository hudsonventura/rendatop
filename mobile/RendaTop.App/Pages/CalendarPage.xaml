<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:calendar="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    Title="Calendario"
    BackgroundColor="#F8FAFC">
    <Grid>
        <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
            <ScrollView>
                <VerticalStackLayout Padding="18,16,18,24" Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Calendario" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                        <Label Text="Visualize as datas de aplicacao e vencimento dos seus investimentos" TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14">
                            <Button Text="Hoje" BackgroundColor="#111827" TextColor="White" Clicked="OnTodayClicked" />

                            <HorizontalStackLayout Spacing="18">
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="#16A34A" StrokeThickness="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Aplicacao" TextColor="#475569" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="#2563EB" StrokeThickness="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Vencimento" TextColor="#475569" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="#EA580C" StrokeThickness="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Resgate" TextColor="#475569" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                            <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />
                            <Label x:Name="EmptyLabel" Text="Nenhum investimento encontrado para montar o calendario." TextColor="#64748B" IsVisible="False" />

                            <calendar:Calendar
                                x:Name="CalendarControl"
                                Events="{Binding CalendarEvents}"
                                ShownDate="{Binding ShownDate}"
                                SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                DayTappedCommand="{Binding DayTappedCommand}"
                                Culture="{Binding CalendarCulture}"
                                EventIndicatorType="BottomDot"
                                EventIndicatorColor="#16A34A"
                                EventIndicatorSelectedColor="#2563EB"
                                TodayOutlineColor="#111827"
                                TodayFillColor="#111827"
                                TodayTextColor="White"
                                SelectedDayBackgroundColor="#0F172A"
                                SelectedDayTextColor="White"
                                DeselectedDayTextColor="#111827"
                                OtherMonthDayColor="#94A3B8"
                                OtherMonthSelectedDayColor="#CBD5E1"
                                UseAbbreviatedDayNames="True"
                                AutoChangeMonthOnDayTap="True"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />

                            <VerticalStackLayout x:Name="SelectedDateSection" Spacing="12" IsVisible="False">
                                <VerticalStackLayout Spacing="2">
                                    <Label x:Name="SelectedDateHeadingLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                                    <Label x:Name="SelectedDateDescriptionLabel" TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Label x:Name="SelectedDateEmptyLabel" Text="Nao ha investimentos relacionados nesta data." TextColor="#64748B" IsVisible="False" />

                                <CollectionView x:Name="SelectedDateCollection" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="14" Margin="0,0,0,10">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="10">
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Border BackgroundColor="{Binding TypeColor}" StrokeThickness="0" Padding="10,4">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="999" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding TypeLabel}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                                        </Border>
                                                    </HorizontalStackLayout>

                                                    <Label Text="{Binding Investment.Title}" FontSize="17" FontAttributes="Bold" TextColor="#111827" />
                                                    <Label Text="{Binding BankName}" TextColor="#475569" />

                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <Label Text="{Binding IndexLabel}" TextColor="#64748B" />
                                                        <Label Grid.Column="1" Text="{Binding RelatedAmountLabel}" FontAttributes="Bold" TextColor="#111827" />
                                                    </Grid>

                                                    <Button
                                                        Text="Ver investimento"
                                                        BackgroundColor="#111827"
                                                        TextColor="White"
                                                        Clicked="OnSelectedEventClicked" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                            <Button Text="Tentar novamente" BackgroundColor="#991B1B" TextColor="White" Clicked="OnRetryClicked" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
