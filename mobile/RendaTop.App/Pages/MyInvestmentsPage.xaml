<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.MyInvestmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:RendaTop.App.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Meus Investimentos"
    BackgroundColor="#F8FAFC">
    <Grid>
        <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
            <CollectionView
                x:Name="InvestmentsCollection"
                SelectionMode="Single"
                SelectionChanged="OnSelectionChanged"
                ItemSizingStrategy="MeasureFirstItem"
                Margin="0,0,0,94">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="18,16,18,16" Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Meus Investimentos" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                            <Label x:Name="SubtitleLabel" Text="Carteira ativa" TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Total atual" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="TotalLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Ativos" FontSize="12" TextColor="#64748B" />
                                    <Label x:Name="CountLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <ActivityIndicator x:Name="LoadingIndicator" Color="#22C55E" IsRunning="False" IsVisible="False" />

                        <Label x:Name="EmptyLabel" Text="Nenhum investimento cadastrado ainda." TextColor="#64748B" IsVisible="False" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="14" Margin="18,0,18,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" TextColor="#111827" LineBreakMode="TailTruncation" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding BankName}" TextColor="#64748B" />
                                    <Label Grid.Column="1" Text="{Binding CurrentValue}" FontAttributes="Bold" TextColor="#111827" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding IndexLabel}" TextColor="#64748B" />
                                    <Label Grid.Column="1" Text="{Binding DueDateLabel}" TextColor="#64748B" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" Margin="18,0,18,20" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                            <Button Text="Tentar novamente" BackgroundColor="#991B1B" TextColor="White" Clicked="OnRetryClicked" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <controls:FloatingActionMenu x:Name="PageFab" />
    </Grid>
</ContentPage>
