<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.SignupVerificationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">
    <ScrollView>
        <Grid Padding="24" MinimumHeightRequest="720">
            <VerticalStackLayout Spacing="22" VerticalOptions="Center">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image Source="brand_icon.svg" HeightRequest="72" WidthRequest="72" />
                    <Label Text="Verificar email" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#111827" />
                    <Label Text="Ative sua conta para entrar no RendaTop" FontSize="15" HorizontalTextAlignment="Center" TextColor="#64748B" />
                </VerticalStackLayout>

                <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="22">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Border BackgroundColor="#ECFDF5" Stroke="#86EFAC" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label x:Name="MessageLabel" TextColor="#166534" />
                        </Border>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Email" FontAttributes="Bold" TextColor="#334155" />
                            <Entry x:Name="EmailEntry" IsReadOnly="True" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Codigo de verificacao" FontAttributes="Bold" TextColor="#334155" />
                            <Entry x:Name="CodeEntry" Keyboard="Numeric" MaxLength="6" Placeholder="000000" />
                        </VerticalStackLayout>

                        <Button
                            x:Name="VerifyButton"
                            Text="Ativar conta"
                            BackgroundColor="#111827"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Clicked="OnVerifyClicked" />

                        <Button
                            x:Name="ResendButton"
                            Text="Reenviar codigo"
                            BackgroundColor="White"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            TextColor="#111827"
                            HeightRequest="46"
                            Clicked="OnResendClicked" />

                        <Border x:Name="ErrorBorder" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" Padding="12" IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label x:Name="ErrorLabel" TextColor="#991B1B" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
