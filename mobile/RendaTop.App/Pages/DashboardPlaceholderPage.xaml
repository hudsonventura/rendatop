<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RendaTop.App.Pages.DashboardPlaceholderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">
    <Grid Padding="24">
        <VerticalStackLayout Spacing="20" VerticalOptions="Center">
            <Image Source="brand_icon.svg" HeightRequest="74" WidthRequest="74" HorizontalOptions="Center" />
            <Label Text="RendaTop" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#111827" />
            <Border BackgroundColor="White" Stroke="#E2E8F0" Padding="22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="WelcomeLabel" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                    <Label x:Name="EmailLabel" TextColor="#64748B" />
                    <Label
                        Text="Login mobile concluido. Na proxima etapa vamos implementar dashboard, configuracoes, meus investimentos e investimentos recorrentes respeitando as permissoes do plano retornadas pelo backend."
                        TextColor="#475569"
                        LineBreakMode="WordWrap" />
                    <Button
                        x:Name="LogoutButton"
                        Text="Sair"
                        Margin="0,10,0,0"
                        BackgroundColor="#111827"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
