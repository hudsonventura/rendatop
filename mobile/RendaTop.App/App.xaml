<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RendaTop.App"
             x:Class="RendaTop.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="#FFFFFF" />
                <Setter Property="Shell.ForegroundColor" Value="#111827" />
                <Setter Property="Shell.TitleColor" Value="#111827" />
                <Setter Property="Shell.DisabledColor" Value="#94A3B8" />
                <Setter Property="Shell.UnselectedColor" Value="#475569" />
                <Setter Property="Shell.FlyoutBackgroundColor" Value="#FFFFFF" />
            </Style>

            <Style TargetType="FlyoutItem" ApplyToDerivedTypes="True">
                <Setter Property="Shell.ForegroundColor" Value="#111827" />
                <Setter Property="Shell.TitleColor" Value="#111827" />
                <Setter Property="Shell.UnselectedColor" Value="#475569" />
            </Style>

            <Style TargetType="Label" ApplyToDerivedTypes="True">
                <Setter Property="TextColor" Value="#111827" />
            </Style>

            <Style TargetType="Entry" ApplyToDerivedTypes="True">
                <Setter Property="TextColor" Value="#111827" />
                <Setter Property="PlaceholderColor" Value="#64748B" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
            </Style>

            <Style TargetType="Button" ApplyToDerivedTypes="True">
                <Setter Property="TextColor" Value="#111827" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
